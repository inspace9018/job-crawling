# =============================================================================
# 맞춤 채용 공고 — 개인 설정 (.env)
# =============================================================================
# 1) 이 파일을 .env 로 복사
# 2) 아래를 본인 정보로 채웁니다
# 3) .env 는 Git에 올리지 마세요
#
# 아래 값들은 실제로 공고 점수 계산·검색에 쓰이는 값만 남긴 것입니다.
# (지원 분야·직함처럼 참고용 문구는 실제 점수에 반영되지 않아 제외했습니다.)
#
# 수집·키워드·포털 ON/OFF → config/search-settings.json (공통 템플릿)
# =============================================================================

# --- 경력 (숫자, 연차) — 경력 적합도 점수 계산에 사용 ---
JOB_SEEKER_EXPERIENCE_YEARS=5

# --- 희망 최소 연봉 (만원, 숫자만) — 연봉 적합도 점수 계산에 사용 ---
SALARY_MIN_MANWON=4000

# --- 내 회사 공고 제외 (쉼표 구분) — 결과에서 해당 회사 공고를 제외 ---
EXCLUDE_COMPANY_ALIASES=회사영문,회사한글

# --- 로그인 쿠키 보관 일수 (리멤버·잡플래닛·Instagram) ---
SESSION_COOKIE_DAYS=180

